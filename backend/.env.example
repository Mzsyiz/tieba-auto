# FastAPI 服务
APP_NAME=Tieba Auto API
ENVIRONMENT=development

# PostgreSQL 连接串（psycopg 3 + SQLAlchemy 2）
# 本机 Homebrew Postgres 默认以当前系统用户信任登录，无需密码
DATABASE_URL=postgresql+psycopg://localhost:5432/tieba_auto

# 允许的前端来源（逗号分隔的 JSON 数组）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# 批量关注/取关时，每个吧之间的随机等待区间（秒）
TIEBA_FOLLOW_MIN_INTERVAL=2
TIEBA_FOLLOW_MAX_INTERVAL=5

# 添加账号后自动同步关注贴吧；测试环境应设为 1 关闭网络同步
# TIEBA_DISABLE_AUTO_SYNC=1
